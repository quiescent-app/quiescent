# Neon PostgreSQL connection string. Keep the real value in .env only.
DATABASE_URL=postgresql://user:password@example.neon.tech/neondb?sslmode=require
JWT_SECRET=
PORT=3000

# Photo storage (use the development bucket output from Terraform).
AWS_REGION=us-east-2
S3_PHOTO_BUCKET=quiescent-photos-<aws-account-id>-development
