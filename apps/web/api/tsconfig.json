{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "model",
    "service",
    "controller",
    "routes",
    "middleware",
    "errors",
    "test",
    "drizzle.config.ts",
    "eslint.config.js",
    "schema",
    "db",
    "app.ts",
    "server.ts"
  ],
  "exclude": ["ui", "drizzle", "node_modules"]
}
